OPENAI_API_KEY=
CERNO_MODEL=gpt-5.6-luna

CERNO_MAX_TOOL_STEPS=8
CERNO_MAX_GRAPH_DEPTH=2
CERNO_MAX_SNIPPET_LINES=120
CERNO_MAX_SEARCH_RESULTS=8
CERNO_CHECK_TIMEOUT=300
CERNO_REQUEST_TIMEOUT=120

# Optional. Cost is reported only when you supply your own prices, in USD per million tokens.
# Leave them unset and `usage.cost_usd` stays null: Cerno never guesses a price.
CERNO_PRICE_INPUT_PER_MTOK=
CERNO_PRICE_OUTPUT_PER_MTOK=

CERNO_DB_PATH=.cerno/cerno.db
CERNO_LOG_LEVEL=INFO
